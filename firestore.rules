rules_version = '2';

// Sicherheitsregeln für die Motorrad-Explorer-Firestore-Datenbank.
//
// Grundprinzip: alles ist nur für eingeloggte Nutzer sichtbar/nutzbar
// (kein anonymer Zugriff von außen), und jeder darf nur seine eigenen
// Einträge anlegen/ändern - lesen dürfen alle eingeloggten Nutzer,
// weil Ranking und Streckenbewertungen ja gemeinsam sichtbar sein
// sollen.
//
// Hinweis zum Freundeskreis-Charakter: aktuell kann sich grundsätzlich
// jeder mit einem Google-Konto einloggen und Daten anlegen. Für
// echten "nur meine Freunde"-Schutz später entweder eine Allow-Liste
// mit E-Mail-Adressen ergänzen oder Einladungscodes einbauen - für
// den Start reicht "eingeloggt = darf mitmachen".

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Öffentliches Profil pro Nutzer (Name fürs Ranking/Anzeige).
    // users/{userId}
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Bewertungen einzelner Streckenabschnitte (OSM way_id-basiert).
    // segment_ratings/{ratingId}
    match /segment_ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Bestätigte Fahrten inkl. Statistik (km, Kehren, etc.).
    // rides/{rideId}
    match /rides/{rideId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Alles andere: gesperrt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
